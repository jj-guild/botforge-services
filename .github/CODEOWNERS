# Code ownership (botforge-services).
# Combined with the "main" ruleset (require code owner review, 1
# approval), no change merges without a maintainer.
# Team: @jj-guild/maintainers (developer + ops).
#
# Default: a maintainer reviews everything
*                       @jj-guild/maintainers

# CI/CD workflows: the deploy path is security-sensitive
/.github/workflows/     @jj-guild/maintainers

# Docker and entrypoint: what runs on the VPS
/Dockerfile             @jj-guild/maintainers
/docker/                @jj-guild/maintainers

# Mod code: owned by the mod's designer (per the roster 'owns' column,
# botforge repo). Default owner for unclaimed mods is Merlin (the
# platform developer) — the contributors-sync ownership check keeps
# this file and the roster in sync.
/src/botforge/mods/ladder/   @merlin-pinpin
